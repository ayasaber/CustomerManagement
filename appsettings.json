{
  "ConnectionStrings": {
    "CustomerManagement": "Server=.\\SQLEXPRESS;Database=CustomerManagementDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "AttachmentStorage": {
    "Provider": "LocalFileSystem",
    "RootPath": "App_Data/attachments",
    "MaxFileSizeBytes": 10485760,
    "AllowedContentTypes": [
      "text/plain",
      "application/pdf",
      "image/png",
      "image/jpeg",
      "application/json"
    ]
  },
  "Jwt": {
    "Issuer": "CustomerManagement.Api",
    "Audience": "CustomerManagement.Clients",
    "SigningKey": "DevOnly-ReplaceThis-With-A-Strong-Secret-Key-12345",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
